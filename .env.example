# Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Session Secret - CHANGE THIS to a long random string in production!
SESSION_SECRET=change-this-to-a-very-long-random-secret-key-in-production

# Database
DB_PATH=./data/secure_login.db

# Session store
SESSION_DB_PATH=./data/sessions.db

# BCRYPT cost factor (10-12 recommended for production)
BCRYPT_ROUNDS=12

